function genCard(rng){
  const cat=rng.pick(CATS);
  const brand=rng.pick(cat.brands), model=rng.pick(cat.models);
  const listino=round5(rng.range(cat.lo,cat.hi));
  const quality=pickQuality(rng);
  const cost=round5(listino*QUALITIES[quality].cost*rng.range(.92,1.08));
  return {cat:cat.id,brand,model,listino,quality,cost,tags:pickTags(rng,quality),
    spu:'SPU-'+randCode(rng,4),wb:randCode(rng,7)};
}
function pickEvent(rng){
  const tot=EVENTS.reduce((s,e)=>s+e.peso,0); let x=rng()*tot;
  for(const e of EVENTS){ x-=e.peso; if(x<0){ const c={...e}; if(c.pick==='one') c.catId=rng.pick(CATS).id; return c; } }
  return {...EVENTS[0],catId:CATS[0].id};
}
function buildRounds(seedStr){
  const rng=makeRNG('game|'+seedStr);
  const rounds=[];
  for(let i=0;i<12;i++){
    const moves={}; CATS.forEach(c=>moves[c.id]=rng.range(-0.11,0.13));
    const ev=(i>0&&rng.chance(.58))?pickEvent(rng):null;
    const rzLot=rng.chance(.07);
    const rzK=rng.int(3);
    const cards=[];
    for(let k=0;k<3;k++){
      const card=genCard(rng);
      if(rzLot&&k===rzK){
        card.quality=rng.chance(.65)?'mirror':'aaa';
        card.cost=round5(card.listino*QUALITIES[card.quality].cost*rng.range(.92,1.08));
        card.tags=pickTags(rng,card.quality);
        card.rzLot=true;
      }
      cards.push(card);
    }
    rounds.push({idx:i,moves,event:ev,rzLot,cards,
      costMod:(ev&&ev.tipo==='cost')?ev.delta:0,quiet:rng.pick(QUIET)});
  }
  return rounds;
}

