            <div class="p-mid"><span class="p-ratio">×${ratio}</span><span class="mono" style="font-size:10px;color:#6b6152">INDICE ${cat.nome} ×${g.market[card.cat].toFixed(2)}</span></div>
            <div class="p-row vendor"><span>PREZZO VENDOR</span><b class="mono">${eur(price)}</b></div>
            ${rnd.costMod?`<div class="p-note mono">${rnd.costMod>0?'+':''}${Math.round(rnd.costMod*100)}% EVENTO DI OGGI SUL PREZZO</div>`:''}
          </div>
          <div class="o-actions">
            <button class="btn btn-buy" data-action="buy" data-i="${i}" ${off?'data-off="1"':''}>${bl}</button>
            <button class="btn btn-pass" data-action="pass" data-i="${i}">PASSA</button>
          </div>
        </div>
      </div>
      ${hinted?`<div class="rz-quote">${rzAvatar(28)}<div>«${RZ_HINT[card.quality]}» <span class="mono">— RIZZITGO, IN CHIAMATA</span></div></div>`:''}
      ${stamp}
    </article>`;
  }).join('');

  /* stash */
  const merch=g.stash.filter(i=>i.revealed).reduce((s,i)=>s+cardValue(i.card),0);
  const transit=g.stash.filter(i=>!i.revealed).reduce((s,i)=>s+i.paid,0);
  const net=g.cash+merch;
  const stashRows=g.stash.length?g.stash.map(it=>{
    if(!it.revealed){
      const eta=(it.arriveRound===11&&it.buyRound===11)?'LIQUIDAZIONE FINALE':'GIORNO '+(it.arriveRound+1);
      return `<div class="s-item transit">
        <div class="s-top"><b>${esc(it.card.brand)} ${esc(it.card.model)}</b><span>${CATBY[it.card.cat].nome} · PAGATO ${eur(it.paid)}</span></div>
        <div class="s-bot"><span class="tr">${IC.plane} IN TRANSITO</span><span class="mono" style="font-size:10px;color:#6b6152">ARRIVO: ${eta}</span></div>
      </div>`;
    }
    const v=cardValue(it.card),pl=v-it.paid,q=QVIS[it.card.quality];
    return `<div class="s-item">
      <span class="qmini" style="color:${q.color}">${q.label}</span>
      <div class="s-top"><b>${esc(it.card.brand)} ${esc(it.card.model)}</b><span>${CATBY[it.card.cat].nome}</span></div>
      <div class="s-bot"><span class="s-val mono">${eur(v)} <em class="${pl>=0?'pos':'neg'}">${pl>=0?'+':''}${Math.round(pl)}</em></span>
      <button class="btn-sell" data-action="sell" data-id="${it.id}">VENDI</button></div>
    </div>`;
  }).join(''):`<div class="stash-empty">IL TUO STASH È VUOTO.<br>IL MERCATO NON ASPETTA.</div>`;

  const done=g.decisions.filter(Boolean).length;
  const last=g.roundIdx===11;
  const rzState=g.rzUsed?'CONSULENZA USATA':(g.rzArmed?'SCEGLI UN\'OFFERTA…':'1 CONSULENZA GRATUITA · OFFRE LO SPONSOR');

  $('#scr-game').innerHTML=`
    <header class="gbar">
      <span class="g-logo">REP<em>RUSH</em></span>
      <span class="mode-tag mono">${modeTag}</span>
      <div class="ticker">${ticker}</div>
      <span class="g-cash ${cashCls}">${eur(g.cash)}</span>
      <button class="btn-icon" data-action="mute" aria-label="Attiva o disattiva i suoni">${FX.on?IC.vol:IC.volOff}</button>
    </header>
    <div class="game-grid">
      <div>
        <div class="dayline">
          <span class="d-lab">GIORNO <em>${day}</em>/12</span>
          <div class="segs">${segs}</div>
        </div>
        ${arrivals}
        <section class="bulletin">
          <span class="b-tag">BOLLETTINO · GIORNO ${day}</span>
          <h3 class="b-tit">${bTit}</h3>
          <p class="b-msg">${bMsg}</p>
          ${bChips?`<div class="b-chips">${bChips}</div>`:''}
          ${rzNote}
        </section>
        <p class="offers-label">OFFERTE DEI VENDOR DI OGGI — 3 LOTTI · DECIDERE ENTRO FINE GIORNATA</p>
        ${offers}
        <div class="actionbar">
          <button class="btn btn-rz ${g.rzUsed?'used':''} ${g.rzArmed?'armed':''}" data-action="arm-rz" ${g.rzUsed?'disabled':''}>
            ${rzAvatar(40)}
            <span class="rz-txt"><b>CHIEDI A RIZZITGO</b><em>${rzState}</em></span>
          </button>
          <button class="btn btn-next" data-action="next" ${done<3?'disabled':''}>
            ${done<3?`VALUTA LE OFFERTE ${done}/3`:(last?'CHIUDI IL MERCATO':'PROSSIMO GIORNO →')}
          </button>
        </div>
      </div>
      <aside class="stash-panel">
        <div class="stash-head"><h3 class="disp">STASH</h3><span class="mono">${g.stash.length}/6 SLOT</span></div>
        <div class="net-box">
          <span class="lbl mono">PATRIMONIO STIMATO</span>
          <div class="net-val">${eur(net)}</div>
          <div class="net-sub">CASH ${eur(g.cash)} · MERCE ${eur(merch)} · TRANSITO ${eur(transit)}</div>
        </div>
        <div id="stash-list">${stashRows}</div>
      </aside>
    </div>`;
}

/* azioni di gioco */
function decideCard(i,act){
  const g=S.game; if(!g||g.decisions[i]) return;
  const rnd=g.rounds[g.roundIdx];
  const card=rnd.cards[i];
  if(act==='buy'){
    const price=buyPrice(card,rnd);
    if(g.cash<price){ toast('Cash insufficiente per questa offerta.','bad'); FX.bad(); return; }
    if(g.stash.length>=6){ toast('Stash pieno: vendi qualcosa prima di comprare.','bad'); FX.bad(); return; }
    const it={id:'it'+(++g.uid),card,paid:price,buyRound:g.roundIdx,
      arriveRound:Math.min(g.roundIdx+2,11),revealed:false};
    g.cash-=price; g.stats.spent+=price; g.stats.bought++;
    g.stash.push(it); g.decisions[i]='buy'; g.animateCard=i;
    FX.buy();
    toast(`${IC.box} Ordine inviato: <b>${esc(card.brand)} ${esc(card.model)}</b> — ${eur(price)}. Arrivo previsto: ${it.arriveRound===11&&g.roundIdx===11?'liquidazione finale':'giorno '+(it.arriveRound+1)}.`);
  } else {
    g.decisions[i]='pass'; g.animateCard=i; FX.click();
  }
  renderGame();
  g.animateCard=null;
}
function sellItem(id){
  const g=S.game; if(!g) return;
  const it=g.stash.find(x=>x.id===id);
  if(!it||!it.revealed) return;
  const v=cardValue(it.card),pl=v-it.paid;
  g.cash+=v; g.stats.earned+=v; g.stats.sold++;
  if(pl>g.stats.bestPl){ g.stats.bestPl=pl; g.stats.bestFlip=it.card.brand+' '+it.card.model; }
  g.stash=g.stash.filter(x=>x.id!==id);
  FX.cash();
  toast(`Venduto <b>${esc(it.card.brand)} ${esc(it.card.model)}</b> a ${eur(v)} <span class="${pl>=0?'pos':'neg'}">(${pl>=0?'+':''}${Math.round(pl)} €)</span>`,pl>=0?'good':'bad');
  renderGame();
}
function toggleRz(){
  const g=S.game; if(!g||g.rzUsed) return;
  g.rzArmed=!g.rzArmed; FX.click(); renderGame();
}
function rzOnCard(i){
  const g=S.game; if(!g||g.rzUsed||g.decisions[i]) return;
  g.rzUsed=true; g.rzArmed=false; g.rzHint=i;
  FX.buy();
  const q=g.rounds[g.roundIdx].cards[i].quality;
  toast(`${rzAvatar(20,'')} RizzitGo: «${RZ_HINT[q]}»`);
  renderGame();
}
function nextRound(){
  const g=S.game; if(!g) return;
  if(g.decisions.filter(Boolean).length<3) return;
  FX.click();
  if(g.roundIdx===11){ endGame(); return; }
  enterRound(g.roundIdx+1);
}
function gradeOf(v){
  if(v<600) return ['SCAMMATO','Il mercato ti ha mangiato vivo.'];
  if(v<1000) return ['FLOP BUYER','Almeno ci hai provato.'];
  if(v<1600) return ['HUSTLER','Cominci a capire il gioco.'];
  if(v<2500) return ['RESELLER','Occhio clinico rispettabile.'];
  if(v<4000) return ['REPGOD','I vendor ti temono.'];
  return ['CEO DI GUANGZHOU','Leggenda del mercato.'];
}
function endGame(){
  const g=S.game;
  g.stash.forEach(it=>{
    if(!it.revealed){
      it.revealed=true;
      if(it.card.quality==='scam'){ it.scamLost=true; g.stats.scam++; g.stats.scamLoss+=it.paid; }
    }
  });
  g.stash=g.stash.filter(it=>!it.scamLost);
  const liquid=g.stash.reduce((s,it)=>s+cardValue(it.card),0);
  g.liquid=liquid; g.final=g.cash+liquid;
  const [grade,gradeSub]=gradeOf(g.final);
  g.grade=grade; g.gradeSub=gradeSub;
  g.boardRoom=g.mode==='room'?g.room:(g.mode==='daily'?'DAILY':null);
  if(g.boardRoom){
    boardSave(g.boardRoom,{name:S.nick,score:g.final,grade,ts:Date.now()});
    boardBroadcast(g.boardRoom);
  }
  renderResults();
  showScreen('results');
}

/* ===== RESULTS ===== */
function renderResults(){
  const g=S.game;
  const mult=(g.final/1000).toFixed(2);
  const code=g.boardRoom?resultEncode({room:g.boardRoom,name:S.nick,score:g.final,grade:g.grade}):null;
  const st=g.stats;
  const rows=[
    ['OFFERTE COMPRATE',st.bought],
    ['PACCHI VENDUTI',st.sold],
    ['SPESO TOTALE',eur(st.spent)],
    ['INCASSATO IN VENDITE',eur(st.earned)],
    ['LIQUIDAZIONE FINALE STASH','+'+eur(g.liquid).slice(2)],
    ['PACCHI SMARRITI (SCAM)',st.scam?st.scam+' · −'+eur(st.scamLoss).slice(2):'0'],
    ['FLIP MIGLIORE',st.bestPl>-1e9?esc(st.bestFlip)+' · +'+Math.round(st.bestPl)+' €':'—'],
    ['CONSULENZA RIZZITGO',g.rzUsed?'USATA':'NON USATA (TIMIDO…)']
  ].map(r=>`<div class="brow-s"><span>${r[0]}</span><b>${r[1]}</b></div>`).join('');

  const share=g.boardRoom?`
    <div class="share">
      <label>CODICE RISULTATO — CONDIVIDILO: CHI LO INCOLLA IN QUESTA STANZA TI VEDE IN CLASSIFICA</label>
      <div class="share-row">
        <code id="rescode">${esc(code||'')}</code>
        <button class="btn" data-action="copy-result">${IC.copy} COPIA</button>
      </div>
      <div class="friend-row">
        <input id="friend-code" placeholder="Incolla qui RR1-… di un amico" autocomplete="off">
        <button class="btn" data-action="add-friend">${IC.plus} AGGIUNGI</button>
      </div>
    </div>`:'';

  const board=g.boardRoom?`<div id="board-slot"></div>`:'';

  const modeTag=g.mode==='room'?'STANZA '+esc(g.room):(g.mode==='daily'?'SFIDA QUOTIDIANA':'PARTITA SINGOLA');
  $('#scr-results').innerHTML=`
  <div class="container results">
    <p class="sec-kicker" style="text-align:center">GIORNO 12 · MERCATO CHIUSO · ${modeTag}</p>
    <div class="res-stamp stamp">${esc(g.grade)}</div>
    <div class="res-money">${eur(g.final)}</div>
    <p class="res-sub">DA € 1.000 IN 12 GIORNI · ×${mult} — ${esc(g.gradeSub).toUpperCase()}</p>
    <div class="res-bill">${rows}</div>
    ${share}
    ${board}
    <div class="res-actions">
      <button class="btn btn-orange" data-action="replay">RIGIOCA</button>
      <button class="btn" data-action="go-home">HOME</button>
    </div>
  </div>`;
  if(g.boardRoom){ renderBoardInto($('#board-slot'),g.boardRoom); }
  FX.cash();
}

/* ---------- delegation eventi ---------- */
document.getElementById('app').addEventListener('click',e=>{
  const el=e.target.closest('[data-action]');
  if(!el) return;
  const a=el.dataset.action;
  switch(a){
    case 'start-single': FX.click(); startGame({mode:'single'}); break;
    case 'start-daily': FX.click(); startGame({mode:'daily'}); break;
    case 'open-lobby': FX.click(); S.lobby.code=''; renderLobby(); showScreen('lobby'); break;
    case 'go-home': FX.click(); renderHome(); showScreen('home'); break;
    case 'gen-code':{
      FX.click();
      const inp=$('#room-in');
      if(inp){ inp.value=genRoomCode(); S.lobby.code=inp.value; updateLobby(); }
      break;
    }
    case 'lobby-start':{
      const code=(S.lobby.code||'').trim();
      if(code.length<4){ toast('Il codice stanza serve di almeno 4 caratteri.','bad'); break; }
      FX.click(); startGame({mode:'room',room:code});
      break;
    }
    case 'buy': case 'pass':{
      if(el.dataset.off){ toast('Stash pieno o cash insufficiente.','bad'); FX.bad(); break; }
      decideCard(+el.dataset.i,a); break;
    }
    case 'rz-card': rzOnCard(+el.dataset.i); break;
    case 'arm-rz': toggleRz(); break;
    case 'sell': sellItem(el.dataset.id); break;
    case 'next': nextRound(); break;
    case 'mute':{
      FX.on=!FX.on; setLS('rr_sound',FX.on);
      FX.init(); if(FX.on) FX.click();
      const b=$('.btn-icon[data-action="mute"]');
      if(b) b.innerHTML=FX.on?IC.vol:IC.volOff;
      break;
    }
    case 'copy-result':{
      const g=S.game;
      const code=$('#rescode')?$('#rescode').textContent:'';
      const where=g.mode==='room'?'STANZA '+g.room:'SFIDA QUOTIDIANA';
      copyText(`REP RUSH · ${where} · ${S.nick} chiude a ${eur(g.final)} (${g.grade}) — batti questo: ${code}`);
      break;
    }
    case 'add-friend':{
      const g=S.game; if(!g||!g.boardRoom) break;
      const inp=$('#friend-code');
      const d=resultDecode(inp?inp.value:'');
      if(!d){ toast('Codice risultato non valido.','bad'); FX.bad(); break; }
      if(d.room.toUpperCase()!==g.boardRoom.toUpperCase()){
        toast(`Questo risultato appartiene alla stanza <b>${esc(d.room)}</b>.`,'bad'); FX.bad(); break;
      }
      boardSave(g.boardRoom,{name:d.name,score:d.score,grade:d.grade,ts:Date.now()});
      boardBroadcast(g.boardRoom);
      renderBoardInto($('#board-slot'),g.boardRoom);
      inp.value='';
      toast(`Aggiunto in classifica: <b>${esc(d.name)}</b> · ${eur(d.score)}`,'good');
      FX.cash();
      break;
    }
    case 'replay':{
      FX.click();
      const g=S.game;
      if(g.mode==='room') startGame({mode:'room',room:g.room});
      else if(g.mode==='daily') startGame({mode:'daily'});
      else startGame({mode:'single'});
      break;
    }
  }
});
document.getElementById('app').addEventListener('input',e=>{
  if(e.target&&e.target.id==='nick-in'){
    S.nick=e.target.value.slice(0,14);
    setLS('rr_nick',S.nick);
  }
});
document.getElementById('app').addEventListener('keydown',e=>{
  if(e.target&&e.target.id==='friend-code'&&e.key==='Enter'){
    const b=document.querySelector('[data-action="add-friend"]');
    if(b) b.click();
  }
});

/* ---------- avvio ---------- */
renderHome();
showScreen('home');
</script>
</body>
