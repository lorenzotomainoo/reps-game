/* ---------- toasts ---------- */
function toast(msg,kind){
  const t=document.createElement('div');
  t.className='toast '+(kind||'');
  t.innerHTML=msg;
  $('#toasts').appendChild(t);
  setTimeout(()=>t.classList.add('out'),3400);
  setTimeout(()=>t.remove(),3900);
}
function copyText(t){
  const done=()=>toast('Copiato negli appunti.','good');
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(t).then(done).catch(()=>fallbackCopy(t,done));
  } else fallbackCopy(t,done);
}
function fallbackCopy(t,done){
  const ta=document.createElement('textarea');
  ta.value=t; ta.style.position='fixed'; ta.style.opacity='0';
  document.body.appendChild(ta); ta.select();
  try{ document.execCommand('copy'); done(); }catch(e){ toast('Copia manuale: '+t); }
  ta.remove();
}

/* ---------- leaderboard stanze + codici risultato ---------- */
function boardKey(room){ return 'rr_board_'+room; }
function boardLoad(room){
  const b=getLS(boardKey(room));
  return Array.isArray(b)?b:[];
}
function boardSave(room,entry){
  const b=boardLoad(room);
  const i=b.findIndex(x=>String(x.name).toLowerCase()===String(entry.name).toLowerCase());
  if(i>=0){ if(entry.score>b[i].score) b[i]=entry; } else b.push(entry);
  b.sort((a,b)=>b.score-a.score);
  const out=b.slice(0,20);
  setLS(boardKey(room),out);
  return out;
}
function resultEncode(e){
  const p=e.room+'~'+e.name+'~'+Math.round(e.score)+'~'+(e.grade||'');
  let b;
  try{ b=btoa(unescape(encodeURIComponent(p))); }catch(err){ return null; }
  return 'RR1-'+b.replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
}
function resultDecode(code){
  try{
    code=String(code).trim();
    if(!code.startsWith('RR1-')) return null;
    let b=code.slice(4).replace(/-/g,'+').replace(/_/g,'/');
    while(b.length%4) b+='=';
    const p=decodeURIComponent(escape(atob(b)));
    const parts=p.split('~');
    if(parts.length<3) return null;
    const score=Number(parts[2]);
    if(!parts[0]||!parts[1]||!isFinite(score)) return null;
    return {room:parts[0],name:parts[1].slice(0,14),score,grade:(parts[3]||'—').slice(0,20)};
  }catch(e){ return null; }
}
/* sync live tra tab dello stesso browser */
const bcSubs={};
function subscribeBoard(room){
  if(bcSubs[room]||!('BroadcastChannel' in window)) return;
  try{
    const ch=new BroadcastChannel('reprush|'+room);
    ch.onmsg=null;
    ch.onmessage=e=>{ if(e.data&&e.data.type==='board') refreshBoardIfVisible(room); };
    bcSubs[room]=ch;
  }catch(e){}
}
function boardBroadcast(room){
  if(!('BroadcastChannel' in window)) return;
  try{ const ch=new BroadcastChannel('reprush|'+room); ch.postMessage({type:'board'}); ch.close(); }catch(e){}
}
function refreshBoardIfVisible(room){
  if(S.screen==='results'&&S.game&&S.game.boardRoom===room){
    const slot=$('#board-slot'); if(slot) renderBoardInto(slot,room);
  } else if(S.screen==='lobby'&&S.lobby.code===room){
    const slot=$('#lobby-board'); if(slot) renderBoardInto(slot,room);
  }
}
function boardHTML(room){
  const b=boardLoad(room);
