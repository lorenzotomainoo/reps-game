function startGame(opts){
  ensureNick();
  const seed = opts.mode==='room' ? 'room|'+opts.room
             : opts.mode==='daily' ? 'daily|'+todayKey()
             : 'single|'+Math.random().toString(36).slice(2,11);
  S.game={
    seed,mode:opts.mode,room:opts.room||null,
    rounds:buildRounds(seed),roundIdx:0,cash:1000,uid:0,
    stash:[],decisions:[null,null,null],
    market:Object.fromEntries(CATS.map(c=>[c.id,1])),tickerDelta:{},
    rzUsed:false,rzArmed:false,rzHint:null,
    stats:{bought:0,sold:0,spent:0,earned:0,scam:0,scamLoss:0,bestPl:-1e9,bestFlip:'—'},
    arrivalNews:[],animateArrivals:false,tickerAnim:false,animateCard:null,
    prevCash:1000,boardRoom:null
  };
  showScreen('game');
  enterRound(0);
}
function buyPrice(card,rnd){ return Math.max(10,Math.round(card.cost*(1+rnd.costMod))); }
function cardValue(card){
  return Math.max(0,Math.round(card.listino*QUALITIES[card.quality].sell*S.game.market[card.cat]));
}
function applyRoundMarket(rnd){
  const g=S.game;
  const prev={...g.market};
  CATS.forEach(c=>{ g.market[c.id]=clamp(g.market[c.id]+rnd.moves[c.id],0.55,2.5); });
  const ev=rnd.event;
  if(ev&&ev.tipo==='index'){
    const targets=ev.pick==='all'?CATS.map(c=>c.id):[ev.pick==='one'?ev.catId:ev.pick];
    targets.forEach(id=>{ g.market[id]=clamp(g.market[id]+ev.delta,0.55,2.5); });
  }
  CATS.forEach(c=>{ g.tickerDelta[c.id]=g.market[c.id]-prev[c.id]; });
}
function enterRound(idx){
  const g=S.game;
  g.roundIdx=idx; g.decisions=[null,null,null]; g.rzHint=null; g.rzArmed=false;
  const rnd=g.rounds[idx];
  applyRoundMarket(rnd);
  g.arrivalNews=[];
  g.stash=g.stash.filter(it=>{
    if(!it.revealed&&it.arriveRound<=idx){
      it.revealed=true;
      g.arrivalNews.push(it);
      if(it.card.quality==='scam'){ it.scamLost=true; g.stats.scam++; g.stats.scamLoss+=it.paid; return false; }
    }
    return true;
  });
  g.animateArrivals=true; g.tickerAnim=true;
  renderGame();
  g.animateArrivals=false; g.tickerAnim=false;
  g.arrivalNews.forEach((it,k)=>{
    setTimeout(()=>{ it.card.quality==='scam'?FX.scam():FX.stamp(); },350+k*480);
  });
}
