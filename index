/* pseudo-QR decorativo deterministico */
function drawQR(cv,seedStr){
  const n=21, cell=4; const rng=makeRNG('qr|'+seedStr);
  cv.width=cv.height=n*cell;
  const c=cv.getContext('2d');
  c.fillStyle='#F2EDE2'; c.fillRect(0,0,cv.width,cv.height); c.fillStyle='#141210';
  const inF=(x,y)=>(x<8&&y<8)||(x>=n-8&&y<8)||(x<8&&y>=n-8);
  for(let y=0;y<n;y++)for(let x=0;x<n;x++){ if(!inF(x,y)&&rng()<.44) c.fillRect(x*cell,y*cell,cell,cell); }
  const finder=(x,y)=>{ c.fillStyle='#141210';c.fillRect(x*cell,y*cell,7*cell,7*cell);
    c.fillStyle='#F2EDE2';c.fillRect((x+1)*cell,(y+1)*cell,5*cell,5*cell);
    c.fillStyle='#141210';c.fillRect((x+2)*cell,(y+2)*cell,3*cell,3*cell); };
  finder(0,0); finder(n-7,0); finder(0,n-7);
}
